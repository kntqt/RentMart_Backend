# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/
**/node_modules/

# ─── Environment Variables & Secrets ─────────────────────────────────────────
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# ─── Database Files ───────────────────────────────────────────────────────────
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db
*.sqlite3
**/*.sqlite
**/*.sqlite-shm
**/*.sqlite-wal

# ─── Uploads / User-Generated Files ──────────────────────────────────────────
server/uploads/*
!server/uploads/.gitkeep
uploads/*
!uploads/.gitkeep

# ─── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Operating System ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ─── IDE & Editor ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ─── Build & Temporary Outputs ────────────────────────────────────────────────
dist/
build/
coverage/
.nyc_output/
tmp/
temp/

# ─── Package Manager Caches ───────────────────────────────────────────────────
.npm/
.pnpm-store/
.yarn/
